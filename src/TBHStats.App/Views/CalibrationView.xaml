<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TBHStats_App.Views.CalibrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TBHStats_App.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolNegationConverter     x:Key="BoolNegationConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <!-- Строка 0: заголовок + кнопки действий -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: область предпросмотра кадра -->
            <RowDefinition Height="2*" />
            <!-- Строка 2: разделитель -->
            <RowDefinition Height="Auto" />
            <!-- Строка 3: список ROI + редактор выбранного -->
            <RowDefinition Height="3*" />
            <!-- Строка 4: статус-бар -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Строка 0: Заголовок + кнопки ──────────────────────────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Калибровка ROI"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    x:Name="CaptureFrameButton"
                    AutomationProperties.Name="Захватить текущий кадр игры"
                    AutomationProperties.AutomationId="CalibrationCaptureFrameButton"
                    Content="Захватить кадр"
                    IsTabStop="True"
                    TabIndex="0"
                    Command="{Binding CaptureFrameCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                    ToolTipService.ToolTip="Сделать снимок окна игры для разметки ROI" />

                <Button
                    x:Name="LoadButton"
                    AutomationProperties.Name="Обновить список ROI из базы данных"
                    AutomationProperties.AutomationId="CalibrationLoadButton"
                    Content="Обновить"
                    IsTabStop="True"
                    TabIndex="1"
                    Command="{Binding LoadCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}" />

                <Button
                    x:Name="AddRoiButton"
                    AutomationProperties.Name="Добавить новую область ROI"
                    AutomationProperties.AutomationId="CalibrationAddRoiButton"
                    Content="Добавить ROI"
                    IsTabStop="True"
                    TabIndex="2"
                    Command="{Binding AddRoiCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}" />

                <Button
                    x:Name="SaveButton"
                    AutomationProperties.Name="Сохранить изменения калибровки ROI"
                    AutomationProperties.AutomationId="CalibrationSaveButton"
                    Content="Сохранить"
                    IsTabStop="True"
                    TabIndex="3"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- ── Строка 1: Предпросмотр кадра (зум/панорамирование) + оверлей ROI ── -->
        <Grid Grid.Row="1">
            <Border
                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <!-- ScrollViewer обеспечивает зум (Ctrl+колесо) и панорамирование (полосы/колесо).
                     Контент PreviewContent имеет размер кадра в пикселях (Width/Height ← FrameWidthPx/Px),
                     поэтому координаты ROI = доля от размера контента (letterbox не нужен). -->
                <ScrollViewer
                    x:Name="PreviewScrollViewer"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.1"
                    MaxZoomFactor="16"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <Grid
                        x:Name="PreviewContent"
                        Width="{Binding FrameWidthPx}"
                        Height="{Binding FrameHeightPx}"
                        Background="Transparent"
                        SizeChanged="PreviewContent_SizeChanged"
                        PointerPressed="PreviewContent_PointerPressed"
                        PointerMoved="PreviewContent_PointerMoved"
                        PointerReleased="PreviewContent_PointerReleased"
                        PointerCaptureLost="PreviewContent_PointerCaptureLost">

                        <!-- Кадр в нативном размере (Stretch=Fill заполняет контент 1:1). -->
                        <Image
                            x:Name="FrameImageControl"
                            Source="{Binding FrameImage}"
                            Stretch="Fill"
                            IsHitTestVisible="False" />

                        <!-- Оверлей ROI-прямоугольников + рамка рисования. -->
                        <Canvas
                            x:Name="RoiOverlayCanvas"
                            IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Подсказка при отсутствии кадра (поверх, по центру) -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                IsHitTestVisible="False"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding FrameImage, Converter={StaticResource NullToVisibilityConverter}}"
                Text="Кадр не захвачен.&#x0a;Нажмите «Захватить кадр», затем обведите область ROI мышью." />

            <!-- Панель масштаба (поверх, сверху-справа) -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,14,0">
                <Button
                    Content="&#x2212;"
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="Уменьшить масштаб кадра"
                    AutomationProperties.AutomationId="CalibrationZoomOutButton"
                    ToolTipService.ToolTip="Уменьшить"
                    Click="ZoomOut_Click" />
                <Button
                    Content="Вписать"
                    Height="32"
                    AutomationProperties.Name="Вписать кадр целиком"
                    AutomationProperties.AutomationId="CalibrationZoomFitButton"
                    ToolTipService.ToolTip="Вписать кадр целиком"
                    Click="ZoomFit_Click" />
                <Button
                    Content="&#x2b;"
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="Увеличить масштаб кадра"
                    AutomationProperties.AutomationId="CalibrationZoomInButton"
                    ToolTipService.ToolTip="Увеличить"
                    Click="ZoomIn_Click" />
            </StackPanel>

            <!-- Подсказка про управление масштабом (поверх, снизу-слева) -->
            <Border
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="8,0,0,8"
                Padding="6,2"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding FrameImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock
                    IsHitTestVisible="False"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ctrl+колесо — масштаб · колесо/полосы — прокрутка · ЛКМ-протяжка — рамка ROI" />
            </Border>
        </Grid>

        <!-- ── Строка 2: Разделитель ────────────────────────────────────────────── -->
        <Border
            Grid.Row="2"
            Height="1"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Margin="0,4" />

        <!-- ── Строка 3: Список ROI + редактор ───────────────────────────────── -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <!-- Левая колонка: список ROI -->
                <ColumnDefinition Width="*" />
                <!-- Правая колонка: редактор выбранного ROI -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ── Список ROI ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Список ROI"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,0,0,4" />

                <ListView
                    Grid.Row="1"
                    x:Name="RoiListView"
                    AutomationProperties.Name="Список областей ROI"
                    AutomationProperties.AutomationId="RoiListView"
                    ItemsSource="{Binding Calibrations}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsTabStop="True"
                    TabIndex="3">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Text="{Binding FieldKey}"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        Text="{Binding Source}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Удалить ROI"
                                    Content="&#xE74D;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipService.ToolTip="Удалить ROI"
                                    Command="{Binding ElementName=RoiListView, Path=DataContext.RemoveRoiCommand}"
                                    CommandParameter="{Binding}"
                                    Width="32"
                                    Height="32" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ── Редактор выбранного ROI ── -->
            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    x:Name="EditorPanel"
                    Spacing="8">

                    <TextBlock
                        Text="Редактор ROI"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Margin="0,0,0,4" />

                    <!-- FieldKey -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="FieldKeyLabel"
                            Grid.Column="0"
                            Text="Поле (FieldKey):"
                            VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="Поле FieldKey для области ROI"
                            AutomationProperties.AutomationId="FieldKeyComboBox"
                            AutomationProperties.LabeledBy="{Binding ElementName=FieldKeyLabel}"
                            ItemsSource="{Binding AvailableFieldKeys}"
                            SelectedItem="{Binding SelectedItem.FieldKey, Mode=TwoWay}"
                            IsEditable="True"
                            IsTabStop="True"
                            TabIndex="4"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Source -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="SourceLabel"
                            Grid.Column="0"
                            Text="Источник:"
                            VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="Источник данных для области ROI"
                            AutomationProperties.AutomationId="SourceComboBox"
                            AutomationProperties.LabeledBy="{Binding ElementName=SourceLabel}"
                            ItemsSource="{Binding AvailableSources}"
                            SelectedItem="{Binding SelectedItem.Source, Mode=TwoWay}"
                            IsTabStop="True"
                            TabIndex="5"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- TabId (вкладка, только для Source=Tab) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TabLabel"
                            Grid.Column="0"
                            Text="Вкладка:"
                            VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="Вкладка интерфейса для области ROI"
                            AutomationProperties.AutomationId="TabComboBox"
                            AutomationProperties.LabeledBy="{Binding ElementName=TabLabel}"
                            ItemsSource="{Binding AvailableTabs}"
                            SelectedValuePath="Id"
                            SelectedValue="{Binding SelectedItem.TabId, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"
                            IsTabStop="True"
                            TabIndex="6"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Координаты ROI: X, Y, W, H -->
                    <TextBlock
                        Text="Координаты (нормализованные доли [0..1]):"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- X -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="X" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox
                                AutomationProperties.Name="Координата X области ROI (нормализованная доля)"
                                AutomationProperties.AutomationId="RoiX"
                                Value="{Binding SelectedItem.X, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                IsTabStop="True"
                                TabIndex="7"
                                SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <!-- Y -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Y" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox
                                AutomationProperties.Name="Координата Y области ROI (нормализованная доля)"
                                AutomationProperties.AutomationId="RoiY"
                                Value="{Binding SelectedItem.Y, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                IsTabStop="True"
                                TabIndex="8"
                                SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <!-- W -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="W" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox
                                AutomationProperties.Name="Ширина области ROI (нормализованная доля)"
                                AutomationProperties.AutomationId="RoiW"
                                Value="{Binding SelectedItem.W, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                IsTabStop="True"
                                TabIndex="9"
                                SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <!-- H -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="H" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox
                                AutomationProperties.Name="Высота области ROI (нормализованная доля)"
                                AutomationProperties.AutomationId="RoiH"
                                Value="{Binding SelectedItem.H, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                IsTabStop="True"
                                TabIndex="10"
                                SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Grid>

                    <!-- OcrEngine -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="OcrEngineLabel"
                            Grid.Column="0"
                            Text="OCR-движок:"
                            VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="OCR-движок для распознавания области ROI"
                            AutomationProperties.AutomationId="OcrEngineComboBox"
                            AutomationProperties.LabeledBy="{Binding ElementName=OcrEngineLabel}"
                            ItemsSource="{Binding AvailableOcrEngines}"
                            SelectedItem="{Binding SelectedItem.OcrEngine, Mode=TwoWay}"
                            IsTabStop="True"
                            TabIndex="11"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- ParseHint -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ParseHintLabel"
                            Grid.Column="0"
                            Text="Подсказка OCR:"
                            VerticalAlignment="Center" />

                        <TextBox
                            Grid.Column="1"
                            AutomationProperties.Name="Подсказка для OCR-распознавания (допустимые символы)"
                            AutomationProperties.AutomationId="ParseHintTextBox"
                            AutomationProperties.LabeledBy="{Binding ElementName=ParseHintLabel}"
                            Text="{Binding SelectedItem.ParseHint, Mode=TwoWay}"
                            PlaceholderText="Необязательно (напр. 0123456789KMB)"
                            IsTabStop="True"
                            TabIndex="12"
                            HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Строка 4: Статус ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="4" ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                IsActive="{Binding IsBusy}"
                Width="16"
                Height="16"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock
                Grid.Column="1"
                Text="{Binding StatusMessage}"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
