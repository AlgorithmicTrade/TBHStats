<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TBHStats_App.Views.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TBHStats_App.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolNegationConverter     x:Key="BoolNegationConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <!-- Строка 0: заголовок -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: панель управления (метрика + scope) -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: строка статуса рекомендации -->
            <RowDefinition Height="Auto" />
            <!-- Строка 3: разделитель -->
            <RowDefinition Height="Auto" />
            <!-- Строка 4: таблица / пустое состояние -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Строка 0: Заголовок ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Text="Сравнение этапов"
            Style="{StaticResource TitleTextBlockStyle}" />

        <!-- ── Строка 1: Панель управления ─────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Цель оптимизации: Золото/час / Опыт/час -->
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="MetricLabel"
                    Text="Цель оптимизации"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    AutomationProperties.Name="Цель оптимизации"
                    AutomationProperties.AutomationId="MetricGroup">
                    <RadioButton
                        x:Name="MetricGoldButton"
                        AutomationProperties.Name="Оптимизация по золото в час"
                        AutomationProperties.AutomationId="MetricGoldButton"
                        Content="Золото/час"
                        GroupName="MetricGroup"
                        IsChecked="True"
                        IsTabStop="True"
                        TabIndex="0"
                        Click="OnMetricGoldClicked" />
                    <RadioButton
                        x:Name="MetricXpButton"
                        AutomationProperties.Name="Оптимизация по опыт в час"
                        AutomationProperties.AutomationId="MetricXpButton"
                        Content="Опыт/час"
                        GroupName="MetricGroup"
                        IsTabStop="True"
                        TabIndex="1"
                        Click="OnMetricXpClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Строка 2: Строка статуса рекомендации (FR-017) ──────────────── -->
        <Border
            Grid.Row="2"
            AutomationProperties.Name="Рекомендация оптимального этапа"
            AutomationProperties.LiveSetting="Polite"
            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            CornerRadius="4"
            Padding="10,6">
            <TextBlock
                AutomationProperties.Name="Рекомендация"
                Text="{Binding StatusText}"
                Style="{StaticResource BodyTextBlockStyle}"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
        </Border>

        <!-- ── Строка 3: Разделитель ────────────────────────────────────────── -->
        <Border
            Grid.Row="3"
            Height="1"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Margin="0,2" />

        <!-- ── Строка 4: Таблица / Пустое состояние ────────────────────────── -->
        <Grid Grid.Row="4">

            <!-- Пустое состояние: только когда IsEmpty = true -->
            <TextBlock
                Text="Нет данных — сыграйте на этапах, чтобы накопить историю"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Таблица этапов: скрыта при IsEmpty = true -->
            <Grid
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolNegationConverter}, ConverterParameter=Visibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Шапка таблицы. Правый отступ 18 = резерв 14 под полосу прокрутки ListView
                     (Padding 0,0,14,0) + 4 на выравнивание с Padding ячеек строк. -->
                <Grid
                    Grid.Row="0"
                    Padding="4,4,18,6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="★"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Этап"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Золото"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"
                               ToolTipService.ToolTip="Среднее золото за забег (по сохранённым забегам)" />
                    <TextBlock Grid.Column="3" Text="Золото/ч"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Опыт"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"
                               ToolTipService.ToolTip="Средний опыт за забег (по сохранённым забегам)" />
                    <TextBlock Grid.Column="5" Text="Опыт/ч"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="Забегов"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Строки этапов -->
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Таблица этапов с историей"
                    AutomationProperties.AutomationId="StagesListView"
                    ItemsSource="{Binding Stages}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="0,0,14,0">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>

                                <!-- ★ / пусто + Rank — маркер рекомендации -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="★"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Этап: только номерная часть ("1-5"), сложность скрыта -->
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding StageNumberLabel}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Золото (среднее за забег) -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AvgGoldText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Золото/ч -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding GoldPerHourText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Опыт (среднее за забег) -->
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding AvgXpText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Опыт/ч -->
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding XpPerHourText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Забегов -->
                                <TextBlock
                                    Grid.Column="6"
                                    Text="{Binding RunCount}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
