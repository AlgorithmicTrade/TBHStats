<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TBHStats_App.Views.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TBHStats_App.Views.Converters"
    mc:Ignorable="d"
    Background="{StaticResource GameBackgroundBrush}">

    <Page.Resources>
        <conv:BoolNegationConverter     x:Key="BoolNegationConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <!-- Row 0: optimization goal selector -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: recommendation status bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: divider -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: table / empty state -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Row 0: Optimization goal panel ──────────────────────────────── -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="MetricLabel"
                    Text="Optimization goal"
                    FontFamily="{StaticResource GameBodyFont}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GameSecondaryTextBrush}"
                    VerticalAlignment="Center" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    AutomationProperties.Name="Optimization goal"
                    AutomationProperties.AutomationId="MetricGroup">
                    <RadioButton
                        x:Name="MetricGoldButton"
                        AutomationProperties.Name="Optimize by gold per hour"
                        AutomationProperties.AutomationId="MetricGoldButton"
                        Content="Gold/h"
                        GroupName="MetricGroup"
                        IsChecked="True"
                        IsTabStop="True"
                        TabIndex="0"
                        Foreground="{StaticResource GameLabelBrush}"
                        FontFamily="{StaticResource GameBodyFont}"
                        FontSize="12"
                        Click="OnMetricGoldClicked" />
                    <RadioButton
                        x:Name="MetricXpButton"
                        AutomationProperties.Name="Optimize by exp per hour"
                        AutomationProperties.AutomationId="MetricXpButton"
                        Content="Exp/h"
                        GroupName="MetricGroup"
                        IsTabStop="True"
                        TabIndex="1"
                        Foreground="{StaticResource GameLabelBrush}"
                        FontFamily="{StaticResource GameBodyFont}"
                        FontSize="12"
                        Click="OnMetricXpClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Row 1: Recommendation status bar (FR-017) ───────────────────── -->
        <Border
            Grid.Row="1"
            AutomationProperties.Name="Best stage recommendation"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource GamePanelBorderStyle}"
            Padding="10,6">
            <TextBlock
                AutomationProperties.Name="Recommendation"
                Text="{Binding StatusText}"
                FontFamily="{StaticResource GameBodyFont}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource GameLabelBrush}"
                TextWrapping="Wrap" />
        </Border>

        <!-- ── Row 2: Divider ───────────────────────────────────────────────── -->
        <Border
            Grid.Row="2"
            Height="1"
            Background="{StaticResource GamePanelBorderBrush}"
            Margin="0,2" />

        <!-- ── Row 3: Table / Empty state ───────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- Empty state: shown when IsEmpty = true -->
            <TextBlock
                Text="No data — play stages to accumulate history"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                FontFamily="{StaticResource GameBodyFont}"
                FontSize="13"
                Foreground="{StaticResource GameSecondaryTextBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Table: hidden when IsEmpty = true -->
            <Grid
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolNegationConverter}, ConverterParameter=Visibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table header. Right padding 18 = 14 for ListView scrollbar + 4 for cell alignment. -->
                <Border
                    Grid.Row="0"
                    Style="{StaticResource GameHeaderBorderStyle}"
                    Margin="0,0,0,2">
                    <Grid Padding="4,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="★"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Stage"
                                   Style="{StaticResource GameTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Time"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="Average stage completion time (over saved runs)" />
                        <TextBlock Grid.Column="3" Text="Gold"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="Average gold per run (over saved runs)" />
                        <TextBlock Grid.Column="4" Text="Gold/h"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Exp"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="Average exp per run (over saved runs)" />
                        <TextBlock Grid.Column="6" Text="Exp/h"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="Runs"
                                   Style="{StaticResource GameTableHeaderTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Stage rows -->
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Stage history table"
                    AutomationProperties.AutomationId="StagesListView"
                    ItemsSource="{Binding Stages}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="0,0,14,0"
                    Background="Transparent">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>

                                <!-- ★ / empty — recommendation marker -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="★"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource GameHeaderForegroundBrush}"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Stage number label only ("1-5"), difficulty hidden -->
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding StageNumberLabel}"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Time (avg run duration) -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AvgDurationText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Gold (avg per run) -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding AvgGoldText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Gold/h -->
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding GoldPerHourText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Exp (avg per run) -->
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding AvgXpText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Exp/h -->
                                <TextBlock
                                    Grid.Column="6"
                                    Text="{Binding XpPerHourText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />

                                <!-- Runs -->
                                <TextBlock
                                    Grid.Column="7"
                                    Text="{Binding RunCount}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource GameBodyFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource GameValueBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
