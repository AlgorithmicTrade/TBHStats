<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TBHStats_App.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TBHStats_App.Views.Converters"
    xmlns:ctrl="using:TBHStats_App.Views.Controls"
    Title="TBHStats"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="8,6,8,8"
        Background="{StaticResource GameBackgroundBrush}">

        <Grid.KeyboardAccelerators>
            <!-- Alt+C — открыть сравнение этапов -->
            <KeyboardAccelerator Modifiers="Menu" Key="C" Invoked="OnCompareAcceleratorInvoked" />
            <!-- Alt+K — открыть калибровку ROI -->
            <KeyboardAccelerator Modifiers="Menu" Key="K" Invoked="OnCalibrationAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <conv:BoolNegationConverter           x:Key="BoolNegationConverter" />
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter" />
            <conv:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Строка 0: заголовок-плашка «TBHSTATS» (зона перетаскивания + ✕) -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: плашки статуса (видимы только когда нет данных) -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: тёмная кожаная панель с живой статистикой -->
            <RowDefinition Height="*" />
            <!-- Строка 3: кнопки и чекбокс -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Строка 0: Заголовок-плашка ─────────────────────────────────── -->
        <!--
            x:Name="HeaderBorder" используется в code-behind для P/Invoke-перетаскивания.
            Строка заголовка служит drag-областью (WM_NCLBUTTONDOWN → HTCAPTION).
            Кнопка ✕ справа вызывает this.Close() → OnWidgetClosed.
        -->
        <Border
            x:Name="HeaderBorder"
            Grid.Row="0"
            Style="{StaticResource GameHeaderBorderStyle}"
            Margin="0,0,0,4"
            HorizontalAlignment="Stretch"
            PointerPressed="OnHeaderPointerPressed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <!-- spacer слева равный ширине кнопки ✕ для центрирования заголовка -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Заголовок «TBHSTATS» — крупный, широкий, золотой (Baloo 2 Bold) -->
                <ctrl:OutlinedTextBlock
                    Grid.Column="1"
                    Text="TBHSTATS"
                    Fill="{StaticResource GameHeaderForegroundBrush}"
                    Stroke="{StaticResource GameTextStrokeBrush}"
                    OutlineThickness="1.5"
                    TextFontFamily="{StaticResource GameHeaderFont}"
                    TextFontSize="20"
                    TextFontWeight="Bold"
                    TextAlignment="Center"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />

                <!-- Кнопка ✕ — закрытие виджета -->
                <Button
                    Grid.Column="2"
                    x:Name="CloseWidgetButton"
                    AutomationProperties.Name="Close widget"
                    AutomationProperties.AutomationId="CloseWidgetButton"
                    Content="✕"
                    Style="{StaticResource GameCloseButtonStyle}"
                    VerticalAlignment="Center"
                    Click="OnCloseWidgetClicked"
                    ToolTipService.ToolTip="Close widget" />
            </Grid>
        </Border>

        <!-- ── Строка 1: Статус-плашки ─────────────────────────────────────── -->

        <!-- Game not found -->
        <Border
            Grid.Row="1"
            AutomationProperties.Name="Status: game not found"
            AutomationProperties.LiveSetting="Polite"
            Background="#FF5A1010"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,0,0,4"
            Visibility="{Binding IsGameFound, Converter={StaticResource BoolNegationConverter},
                                  ConverterParameter=Visibility}">
            <TextBlock
                Text="Game not found"
                Foreground="#FFFF9090"
                FontFamily="{StaticResource GameHeaderFont}"
                FontWeight="Normal"
                HorizontalAlignment="Center" />
        </Border>

        <!-- Waiting -->
        <Border
            Grid.Row="1"
            AutomationProperties.Name="Status: waiting for game window"
            AutomationProperties.LiveSetting="Polite"
            Background="#FF5A4500"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,0,0,4"
            Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Text="Waiting"
                Foreground="#FFFFD060"
                FontFamily="{StaticResource GameHeaderFont}"
                FontWeight="Normal"
                HorizontalAlignment="Center" />
        </Border>

        <!-- ── Строка 2: Тёмная кожаная панель — живая статистика ──────────── -->
        <Border
            Grid.Row="2"
            Style="{StaticResource GamePanelBorderStyle}"
            Padding="6,4"
            Margin="0,0,0,4">

            <StackPanel Spacing="0">

            <!-- Строка переключателя/настроек: «Забег ⇄ Сессия» слева, «Поверх окон» справа -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Переключатель «Забег / Сессия» (у левого края окна) -->
                <CheckBox
                    x:Name="SessionViewCheckBox"
                    Grid.Column="0"
                    AutomationProperties.Name="Toggle session view"
                    AutomationProperties.AutomationId="SessionViewCheckBox"
                    Content="Session"
                    Style="{StaticResource GameCheckBoxStyle}"
                    IsChecked="{Binding IsSessionView, Mode=TwoWay}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Switch between Run and Session statistics" />

                <!-- Checkbox "On top" (FR-015) — перемещён сюда, на место бывшего Session (справа) -->
                <CheckBox
                    x:Name="AlwaysOnTopCheckBox"
                    Grid.Column="2"
                    AutomationProperties.Name="Always on top"
                    AutomationProperties.AutomationId="AlwaysOnTopCheckBox"
                    Content="On top"
                    Style="{StaticResource GameCheckBoxStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnAlwaysOnTopClicked" />
            </Grid>

            <!-- Блок «Забег» (виден когда IsSessionView == false) -->
            <Grid RowSpacing="2"
                  Visibility="{Binding IsSessionView, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Gold/hour -->
                <Grid Grid.Row="0" AutomationProperties.Name="Gold per hour">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Gold/h"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        x:Name="GoldPerHourValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Gold per hour"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding GoldPerHourText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Exp/hour -->
                <Grid Grid.Row="1" AutomationProperties.Name="Exp per hour">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Exp/h"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        x:Name="XpPerHourValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Exp per hour"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding XpPerHourText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Chests/hour — TEMPORARILY HIDDEN (chest detection disabled, T062 backlog; FieldExtractor.ChestDetectionEnabled) -->
                <Grid Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Chests per hour by type">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Chests/h"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <TextBlock
                        x:Name="ChestsPerHourValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Chests per hour by type"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding ChestsPerHourText}"
                        Style="{StaticResource GameValueTextStyle}"
                        ToolTipService.ToolTip="{Binding ChestsPerHourText}" />
                </Grid>

                <!-- Current gold (OCR control) -->
                <Grid Grid.Row="3" AutomationProperties.Name="Current gold">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Gold"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        x:Name="GoldCurrentValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Current gold"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding GoldText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Current gold; in parentheses — gold gained on the previous completed stage (by boss)" />
                </Grid>

                <!-- Current exp (OCR control) -->
                <Grid Grid.Row="4" AutomationProperties.Name="Current exp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Exp"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        x:Name="XpCurrentValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Current exp"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding XpCurrentText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Current exp / exp to level; in parentheses — exp gained on the previous completed stage (by boss)" />
                </Grid>

                <!-- To level — estimated time to next level at current Exp/h -->
                <Grid Grid.Row="5" AutomationProperties.Name="Time to next level">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="To level"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        x:Name="TimeToLevelValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Estimated time to next level"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding TimeToLevelText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Estimate based on current exp, exp to level and Exp/h rate" />
                </Grid>

                <!-- Current chests — TEMPORARILY HIDDEN (chest detection disabled, T062 backlog; FieldExtractor.ChestDetectionEnabled) -->
                <Grid Grid.Row="6" Visibility="Collapsed" AutomationProperties.Name="Current chests by type">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Chests"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <TextBlock
                        x:Name="ChestsCurrentValue"
                        Grid.Column="1"
                        AutomationProperties.Name="Current chests by type"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding ChestsCurrentText}"
                        Style="{StaticResource GameValueTextStyle}"
                        ToolTipService.ToolTip="{Binding ChestsCurrentText}" />
                </Grid>

                <!-- Hero -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Hero"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            Text="{Binding HeroClassText}"
                            Style="{StaticResource GameCaptionTextStyle}" />
                        <ctrl:OutlinedTextBlock
                            Text="{Binding HeroLevelText}"
                            Fill="{StaticResource GameValueBrush}"
                            Stroke="{StaticResource GameTextStrokeBrush}"
                            OutlineThickness="1.0"
                            TextFontFamily="{StaticResource GameBodyFont}"
                            TextFontSize="12"
                            TextFontWeight="SemiBold"
                            TextAlignment="Right"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Stage -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Stage"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        Text="{Binding StageText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Next location (current stage + 1)" />
                </Grid>

                <!-- Stage progress (% + ProgressBar) -->
                <StackPanel
                    Grid.Row="9"
                    Spacing="2"
                    AutomationProperties.Name="Stage progress">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Stage progress"
                            Style="{StaticResource GameLabelTextStyle}" />
                        <ctrl:OutlinedTextBlock
                            Grid.Column="1"
                            AutomationProperties.Name="Current stage progress"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{Binding StageProgressText}"
                            Fill="{StaticResource GameValueBrush}"
                            Stroke="{StaticResource GameTextStrokeBrush}"
                            OutlineThickness="1.0"
                            TextFontFamily="{StaticResource GameBodyFont}"
                            TextFontSize="12"
                            TextFontWeight="SemiBold"
                            TextAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding StageProgress}"
                        Style="{StaticResource GameProgressBarStyle}" />
                </StackPanel>

                <!-- Time on current stage (segment timer) -->
                <Grid Grid.Row="10" AutomationProperties.Name="Stage time">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Stage time"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Time on current stage"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding StageElapsedText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Current stage time; in parentheses — duration of the previous completed stage (by boss)" />
                </Grid>

                <!-- Статус + время обновления (устаревание) -->
                <!--
                    Строка статуса (T068 Phase 4b): лейбл «Status» в едином GameLabelTextStyle,
                    значение — OutlinedTextBlock (как у остальных строк виджета).
                    LastUpdateText — компактная подпись под строкой статуса (GameCaptionTextStyle).
                -->
                <StackPanel Grid.Row="11" Spacing="1" Margin="0,2,0,0">
                    <Grid AutomationProperties.Name="Status">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Status"
                            Style="{StaticResource GameLabelTextStyle}" />
                        <ctrl:OutlinedTextBlock
                            Grid.Column="1"
                            AutomationProperties.Name="Capture status"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{Binding StatusText}"
                            Fill="{StaticResource GameValueBrush}"
                            Stroke="{StaticResource GameTextStrokeBrush}"
                            OutlineThickness="1.0"
                            TextFontFamily="{StaticResource GameBodyFont}"
                            TextFontSize="12"
                            TextFontWeight="SemiBold"
                            TextAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Text="{Binding LastUpdateText}"
                        Style="{StaticResource GameCaptionTextStyle}"
                        Opacity="{Binding IsStale, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTipService.ToolTip="Time of last successful read" />
                </StackPanel>
            </Grid>

            <!-- Блок «Сессия» (виден когда IsSessionView == true) -->
            <Grid RowSpacing="2"
                  Visibility="{Binding IsSessionView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Session gold -->
                <Grid Grid.Row="0" AutomationProperties.Name="Session gold gained">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Session gold"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Session gold gained"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding SessionGoldText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Session exp -->
                <Grid Grid.Row="1" AutomationProperties.Name="Session exp gained">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Session exp"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Session exp gained"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding SessionXpText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Stages completed -->
                <Grid Grid.Row="2" AutomationProperties.Name="Stages completed this session">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Stages"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Stages completed this session"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding SessionStagesText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Levels gained -->
                <Grid Grid.Row="3" AutomationProperties.Name="Levels gained this session">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Levels"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Levels gained this session"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding SessionLevelsText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Uptime -->
                <Grid Grid.Row="4" AutomationProperties.Name="Session uptime">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Uptime"
                        Style="{StaticResource GameLabelTextStyle}" />
                    <ctrl:OutlinedTextBlock
                        Grid.Column="1"
                        AutomationProperties.Name="Session uptime"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding SessionUptimeText}"
                        Fill="{StaticResource GameValueBrush}"
                        Stroke="{StaticResource GameTextStrokeBrush}"
                        OutlineThickness="1.0"
                        TextFontFamily="{StaticResource GameBodyFont}"
                        TextFontSize="12"
                        TextFontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

            </Grid>

            </StackPanel>
        </Border>

        <!-- ── Строка 3: кнопки (у левого края, на месте бывшего «On top») ─── -->
        <Grid Grid.Row="3">

            <!-- Кнопки слева -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Spacing="6">

                <!-- Button to move game window off-screen -->
                <Button
                    x:Name="HideGameButton"
                    AutomationProperties.Name="Hide or restore game window"
                    AutomationProperties.AutomationId="HideGameButton"
                    Content="Hide game"
                    Style="{StaticResource GameButtonStyle}"
                    TabIndex="0"
                    IsTabStop="True"
                    Click="OnHideGameClicked"
                    ToolTipService.ToolTip="Move game window off-screen (stats keep collecting)" />

                <Button
                    x:Name="CompareButton"
                    AutomationProperties.Name="Open stage comparison"
                    AutomationProperties.AutomationId="CompareButton"
                    Content="Compare"
                    Style="{StaticResource GameButtonStyle}"
                    TabIndex="1"
                    IsTabStop="True"
                    Click="OnCompareClicked"
                    ToolTipService.ToolTip="Open stage comparison (Alt+C)" />

                <Button
                    x:Name="CalibrationButton"
                    AutomationProperties.Name="Open ROI calibration"
                    AutomationProperties.AutomationId="CalibrationButton"
                    Content="Calibration"
                    Style="{StaticResource GameButtonStyle}"
                    TabIndex="2"
                    IsTabStop="True"
                    Click="OnCalibrationClicked"
                    ToolTipService.ToolTip="Open ROI calibration (Alt+K)" />

            </StackPanel>
        </Grid>

    </Grid>
</Window>
