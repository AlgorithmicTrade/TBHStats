<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TBHStats_App.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TBHStats_App.Views.Converters"
    Title="TBHStats"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="12,10,12,12"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.KeyboardAccelerators>
            <!-- Alt+C — открыть сравнение этапов -->
            <KeyboardAccelerator Modifiers="Menu" Key="C" Invoked="OnCompareAcceleratorInvoked" />
            <!-- Alt+G — открыть графики трендов -->
            <KeyboardAccelerator Modifiers="Menu" Key="G" Invoked="OnChartsAcceleratorInvoked" />
            <!-- Alt+K — открыть калибровку ROI -->
            <KeyboardAccelerator Modifiers="Menu" Key="K" Invoked="OnCalibrationAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <conv:BoolNegationConverter     x:Key="BoolNegationConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Строка 0: плашка статуса (видима только когда нет данных) -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: основная статистика -->
            <RowDefinition Height="*" />
            <!-- Строка 2: кнопки -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Строка 0: Статус-плашка ─────────────────────────────────────── -->

        <!-- Игра не найдена -->
        <Border
            Grid.Row="0"
            AutomationProperties.Name="Статус: игра не найдена"
            AutomationProperties.LiveSetting="Polite"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,0,0,8"
            Visibility="{Binding IsGameFound, Converter={StaticResource BoolNegationConverter},
                                  ConverterParameter=Visibility}">
            <TextBlock
                Text="Игра не найдена"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
        </Border>

        <!-- Ожидание -->
        <Border
            Grid.Row="0"
            AutomationProperties.Name="Статус: ожидание окна игры"
            AutomationProperties.LiveSetting="Polite"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,0,0,8"
            Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Text="Ожидание"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
        </Border>

        <!-- ── Строка 1: Живая статистика ─────────────────────────────────── -->
        <Grid Grid.Row="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Золото/час -->
            <Grid Grid.Row="0" AutomationProperties.Name="Золото в час">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Золото/ч"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="GoldPerHourValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Золото в час"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding GoldPerHourText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Опыт/час -->
            <Grid Grid.Row="1" AutomationProperties.Name="Опыт в час">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Опыт/ч"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="XpPerHourValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Опыт в час"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding XpPerHourText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Сундуки/час — ВРЕМЕННО СКРЫТО (обнаружение сундуков отключено, T062 backlog; FieldExtractor.ChestDetectionEnabled) -->
            <Grid Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Сундуки в час по типам">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Сундуки/ч"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ChestsPerHourValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Сундуки в час по типам"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ChestsPerHourText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{Binding ChestsPerHourText}" />
            </Grid>

            <!-- Текущее золото (OCR-контроль) -->
            <Grid Grid.Row="3" AutomationProperties.Name="Текущее золото">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Золото"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="GoldCurrentValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Текущее золото"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding GoldText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Текущий опыт (OCR-контроль) -->
            <Grid Grid.Row="4" AutomationProperties.Name="Текущий опыт">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Опыт"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="XpCurrentValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Текущий опыт"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding XpCurrentText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- До уровня — оценка времени до следующего уровня при текущем опыт/ч -->
            <Grid Grid.Row="5" AutomationProperties.Name="Время до следующего уровня">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="До уровня"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TimeToLevelValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Оценка времени до следующего уровня"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding TimeToLevelText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Оценка по текущему опыту, опыту до уровня и темпу опыт/ч" />
            </Grid>

            <!-- Текущие сундуки — ВРЕМЕННО СКРЫТО (обнаружение сундуков отключено, T062 backlog; FieldExtractor.ChestDetectionEnabled) -->
            <Grid Grid.Row="6" Visibility="Collapsed" AutomationProperties.Name="Текущие сундуки по типам">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Сундуки"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ChestsCurrentValue"
                    Grid.Column="1"
                    AutomationProperties.Name="Текущие сундуки по типам"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ChestsCurrentText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{Binding ChestsCurrentText}" />
            </Grid>

            <!-- Герой -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Герой"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        Text="{Binding HeroClassText}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding HeroLevelText}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding HeroDamageText}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Этап -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Этап"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding StageText}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Следующая локация (текущий этап + 1)" />
            </Grid>

            <!-- Статус + время обновления (устаревание) -->
            <Grid Grid.Row="9" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusText}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding LastUpdateText}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Opacity="{Binding IsStale, Converter={StaticResource BoolToVisibilityConverter}}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Время последнего успешного распознавания" />
            </Grid>
        </Grid>

        <!-- ── Строка 2: Кнопки ────────────────────────────────────────────── -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="0,8,0,0">

            <Button
                x:Name="ChartsButton"
                AutomationProperties.Name="Открыть графики трендов"
                AutomationProperties.AutomationId="ChartsButton"
                Content="Графики"
                TabIndex="0"
                IsTabStop="True"
                Click="OnChartsClicked"
                ToolTipService.ToolTip="Открыть графики трендов (Alt+G)" />

            <Button
                x:Name="CompareButton"
                AutomationProperties.Name="Открыть сравнение этапов"
                AutomationProperties.AutomationId="CompareButton"
                Content="Сравнение"
                TabIndex="1"
                IsTabStop="True"
                Click="OnCompareClicked"
                ToolTipService.ToolTip="Открыть сравнение этапов (Alt+C)" />

            <Button
                x:Name="CalibrationButton"
                AutomationProperties.Name="Открыть калибровку ROI"
                AutomationProperties.AutomationId="CalibrationButton"
                Content="Калибровка"
                TabIndex="2"
                IsTabStop="True"
                Click="OnCalibrationClicked"
                ToolTipService.ToolTip="Открыть калибровку ROI (Alt+K)" />

        </StackPanel>

    </Grid>
</Window>
